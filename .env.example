# Server Port
PORT=5001

# Google Sheets Configuration
# The ID from the URL of your Google Sheet: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Service Account Option 1: File path to service-account-key.json
GOOGLE_CREDENTIALS_PATH=./service-account-key.json

# Service Account Option 2: Inline JSON string (useful for CI/Docker)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# Service Account Option 3: Individual credentials
# GOOGLE_CLIENT_EMAIL=fleet-service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Two-way Polling Interval (in milliseconds, default 20000 = 20s)
SYNC_INTERVAL_MS=20000
